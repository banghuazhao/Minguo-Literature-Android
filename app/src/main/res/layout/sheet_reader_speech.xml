<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_gutter"
    android:paddingEnd="@dimen/page_gutter"
    android:paddingBottom="@dimen/space_24">

    <View
        android:id="@+id/sheet_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_16"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/speech_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/read_aloud"
        android:textAppearance="@style/TextAppearance.NovelsHub.SectionLabel" />

    <TextView
        android:id="@+id/speech_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:accessibilityLiveRegion="polite"
        android:text="@string/tts_ready" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:labelFor="@id/speech_voice"
        android:text="@string/tts_voice" />

    <Spinner
        android:id="@+id/speech_voice"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/tts_voice" />

    <TextView
        android:id="@+id/speech_rate_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:text="@string/tts_speed" />

    <com.google.android.material.slider.Slider
        android:id="@+id/speech_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/tts_speed"
        android:valueFrom="0.6"
        android:valueTo="1.5"
        android:stepSize="0.1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speech_toggle"
            style="@style/Widget.NovelsHub.SheetAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tts_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/speech_stop"
            style="@style/Widget.NovelsHub.SheetAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:text="@string/tts_stop" />
    </LinearLayout>
</LinearLayout>
